#!/usr/bin/env sh
# Install volta for the current user: binary, launcher entry and icon.
#
#   bin/install              into ~/.local
#   PREFIX=/usr bin/install  into /usr (needs root for the copy)
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
prefix=${PREFIX:-$HOME/.local}

cargo build --release --locked --manifest-path "$here/Cargo.toml"

install -d "$prefix/bin" \
           "$prefix/share/applications" \
           "$prefix/share/icons/hicolor/scalable/apps"
install -m 755 "$here/target/release/volta" "$prefix/bin/volta"
install -m 644 "$here/pkgbuild/volta.desktop" "$prefix/share/applications/volta.desktop"
install -m 644 "$here/pkgbuild/volta.svg" \
  "$prefix/share/icons/hicolor/scalable/apps/volta.svg"

command -v update-desktop-database >/dev/null 2>&1 &&
  update-desktop-database "$prefix/share/applications" || true
command -v gtk-update-icon-cache >/dev/null 2>&1 &&
  gtk-update-icon-cache -f -t "$prefix/share/icons/hicolor" || true

printf 'volta установлена: %s\n' "$prefix/bin/volta"
case ":$PATH:" in
  *":$prefix/bin:"*) ;;
  *) printf 'добавь %s/bin в PATH, иначе launcher не найдёт команду\n' "$prefix" ;;
esac
